#include <windows.h>
#include "../src/resource.h"

IDI_APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "Replayr"
            VALUE "FileDescription", "Replayr - game clips and screenshots"
            VALUE "FileVersion", "0.1.0"
            VALUE "InternalName", "Replayr"
            VALUE "OriginalFilename", "Replayr.exe"
            VALUE "ProductName", "Replayr"
            VALUE "ProductVersion", "0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END

// Poppins (SIL Open Font License, see assets/fonts/OFL.txt), loaded from memory at startup.
FONT_REGULAR  RCDATA "fonts/Poppins-Regular.ttf"
FONT_MEDIUM   RCDATA "fonts/Poppins-Medium.ttf"
FONT_SEMIBOLD RCDATA "fonts/Poppins-SemiBold.ttf"
LOGO_PNG      RCDATA "logo.png"
